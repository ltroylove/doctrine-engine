 /** Sum of amounts for entries matching the filter. */
@@ -9,6 +10,7 @@ export function sumEntries(entries: Entry[], filter: SumFilter = {}): number {
   let total = 0;
   for (const e of entries) {
     if (filter.category !== undefined && e.category !== filter.category) continue;
